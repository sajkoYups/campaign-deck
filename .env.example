# Database
DATABASE_URL=postgresql://campaigndeck:campaigndeck@localhost:5432/campaigndeck?schema=public
# On Render, use the internal Postgres URL. sslmode=require is appended in production if missing.

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Public app URL used for redirects and short links
APP_URL=http://localhost:3000
# On Render, APP_URL and BETTER_AUTH_URL fall back to RENDER_EXTERNAL_URL if unset.

# Optional. Defaults to {APP_URL}/r
# SHORT_URL_BASE=http://localhost:3000/r
